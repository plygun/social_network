# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Third-party (optional — email verification falls back to allow-all when blank)
HUNTER_API_KEY=
CLEARBIT_API_KEY=

# Bot defaults (used by `python manage.py run_bot`)
BOT_NUMBER_OF_USERS=5
BOT_MAX_POSTS_PER_USER=3
BOT_MAX_LIKES_PER_USER=7
BOT_API_BASE_URL=http://localhost:8000/v1/
